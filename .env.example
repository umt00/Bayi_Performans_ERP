# ==============================================================================
# Bayi Performans Platformu - Ortam Değişkenleri (.env.example)
# ==============================================================================
# Bu dosyayı '.env' olarak kopyalayıp değerlerinizi girin:
#   cp .env.example .env
#
# Ardından tüm sistemi tek komutla başlatabilirsiniz:
#   docker compose up -d
# ==============================================================================

# PostgreSQL / Supabase Veritabanı Bağlantısı
SUPABASE_DB_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Supabase Auth Yapılandırması (JWT / Oturum)
SUPABASE_URL=https://PROJECT_REFERENCE.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

# Güvenlik ve İzin Verilen Kaynaklar
REQUIRE_AUTH=false
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# AI Yorum Servisi (Groq / OpenAI Uyumlu)
GROQ_API_KEY=YOUR_GROQ_API_KEY
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

# E-posta Bildirimleri (Opsiyonel / Brevo)
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=Bayi Performans
