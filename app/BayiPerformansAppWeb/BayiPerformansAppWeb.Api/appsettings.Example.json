{
  "Database": {
    "ConnectionString": "Host=<SUPABASE_TRANSACTION_POOLER_HOST>;Port=6543;Database=postgres;Username=<APPLICATION_DATABASE_USER>;Password=<DATABASE_PASSWORD>;SSL Mode=VerifyFull;Root Certificate=<LOCAL_ABSOLUTE_CA_PATH>",
    "CommandTimeoutSeconds": 30,
    "MaximumPoolSize": 5,
    "MinimumPoolSize": 0,
    "ConnectionIdleLifetimeSeconds": 60
  },
  "SupabaseAuth": {
    "ProjectUrl": "https://<SUPABASE_PROJECT_REF>.supabase.co",
    "PublishableKey": "<SUPABASE_PUBLISHABLE_KEY>",
    "Audience": "authenticated",
    "HttpTimeoutSeconds": 15
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "AllowInMemoryFallback": true
  },
  "Swagger": {
    "Enabled": true
  },
  "BackgroundJobs": {
    "ScoreCalculationEnabled": false
  },
  "Elasticsearch": {
    "Enabled": true,
    "Url": "http://localhost:9200",
    "IndexName": "satislar_index",
    "TimeoutSeconds": 5,
    "ApiKey": ""
  },
  "BrevoEmail": {
    "Enabled": true,
    "ApiKey": "<BREVO_API_KEY>",
    "FromEmail": "<VERIFIED_BREVO_SENDER_EMAIL>",
    "FromName": "Bayi Performans",
    "TimeoutSeconds": 15
  }
}
