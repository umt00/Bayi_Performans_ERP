{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:5500",
      "http://127.0.0.1:5500"
    ]
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "AllowInMemoryFallback": true
  },
  "Swagger": {
    "Enabled": true
  },
  "OtpSettings": {
    "GecerlilikSuresiSaniye": 180,
    "YenidenGonderimBeklemeSuresiSaniye": 60,
    "MaksimumDenemeSayisi": 3,
    "KodUzunlugu": 6
  },
  "Elasticsearch": {
    "Enabled": true,
    "Url": "http://localhost:9200",
    "IndexName": "satislar_index",
    "TimeoutSeconds": 5
  }
}
