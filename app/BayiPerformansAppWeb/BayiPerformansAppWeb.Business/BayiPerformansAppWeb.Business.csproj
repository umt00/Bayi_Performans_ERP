<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\BayiPerformansAppWeb.DataAccess\BayiPerformansAppWeb.DataAccess.csproj" />
		<ProjectReference Include="..\BayiPerformansAppWeb.Entities\BayiPerformansAppWeb.Entities.csproj" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="BayiPerformansAppWeb.Business.Tests" />
		<InternalsVisibleTo Include="BayiPerformansAppWeb.Api.Tests" />
	</ItemGroup>

	<!--
    Business kurallarında kullanılan thresholds.json dosyasını
    projeye dahil ediyoruz.

    CopyToOutputDirectory:
    Uygulama build edildiğinde thresholds.json'ın
    build çıktısına kopyalanmasını sağlar.

    CopyToPublishDirectory:
    Uygulama publish edildiğinde de dosyanın
    publish çıktısına dahil edilmesini sağlar.

    Böylece dosya runtime sırasında erişilebilir olur.
  -->
	<ItemGroup>
		<None Update="Configuration\thresholds.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>
	</ItemGroup>

</Project>